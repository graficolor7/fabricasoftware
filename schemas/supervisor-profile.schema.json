{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/graficolor7/fabricasoftware/schemas/supervisor-profile.schema.json",
  "title": "SupervisorProfile",
  "description": "Configuración del supervisor para un proyecto (.factory/supervisor.json en el repo del proyecto). Es configuración de confianza: la escribe el Director con aprobación del PO, nunca un paquete ni la evidencia.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "repository", "review_id_prefix"],
  "$defs": {
    "trigger": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" }
  },
  "properties": {
    "schema_version": { "const": "1" },
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "review_id_prefix": { "type": "string", "pattern": "^[A-Z0-9]{2,16}$" },
    "project_state": { "type": "string" },
    "supervisor_state": { "type": "string" },
    "reviews_dir": { "type": "string" },
    "triggers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "additional": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description"],
            "properties": { "id": { "$ref": "#/$defs/trigger" }, "description": { "type": "string" }, "maps_to": { "$ref": "#/$defs/trigger" } }
          }
        }
      }
    },
    "escalation_rules": {
      "type": "array",
      "description": "Si un cambio toca estas rutas, factory trigger evaluate propone el trigger. Solo avisa; no llama al supervisor.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trigger", "paths", "description"],
        "properties": {
          "trigger": { "$ref": "#/$defs/trigger" },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "description": { "type": "string" }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "category", "argv"],
        "properties": {
          "name": { "type": "string" },
          "category": { "enum": ["build", "lint", "typecheck", "unit", "integration", "e2e", "visual", "benchmarks", "security", "platform", "other"] },
          "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "cwd": { "type": "string" },
          "required": { "type": "boolean" },
          "timeout_s": { "type": "integer", "minimum": 1, "maximum": 7200 }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_roots": { "type": "array", "items": { "type": "string" } },
        "denied_globs": { "type": "array", "items": { "type": "string" } },
        "adr_files": { "type": "array", "items": { "type": "string" } },
        "contract_files": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "config": {
      "type": "object",
      "description": "Sobrescribe los valores por defecto de config/supervisor.defaults.json. Las variables de entorno mandan sobre esto.",
      "propertyNames": { "pattern": "^SUPERVISOR_[A-Z_]+$" },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": { "type": ["string", "array", "object"] }
    },
    "notes": { "type": "string" }
  }
}
