{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/graficolor7/fabricasoftware/schemas/project-state.schema.json",
  "title": "ProjectState",
  "description": "Estado mínimo legible por máquina. Apunta al conocimiento; no lo duplica.",
  "type": "object",
  "required": ["schema_version", "factory_version", "project_id", "project_version", "updated_at", "last_verified_commit", "current_milestone", "milestones", "contracts", "pointers", "status"],
  "properties": {
    "schema_version": { "const": "1" },
    "factory_version": { "type": "string" },
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "project_version": { "type": "string" },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "last_verified_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "status": { "enum": ["NORMAL", "SUPERVISOR_PENDING", "MODEL_UNAVAILABLE", "DEGRADED_MODE", "HUMAN_REVIEW_REQUIRED"] },
    "current_milestone": { "type": "string" },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["PLANNED", "ACTIVE", "CLOSED", "BLOCKED"] },
          "closed_commit": { "type": "string" },
          "closure_record": { "type": "string" }
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "status", "path"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "status": { "enum": ["DRAFT", "PROVISIONAL", "FROZEN"] },
          "path": { "type": "string" }
        }
      }
    },
    "open_risks": { "type": "array", "items": { "type": "string" } },
    "known_issues_ref": { "type": "string" },
    "domains": { "type": "array", "items": { "type": "string" } },
    "pointers": { "type": "object", "additionalProperties": { "type": "string" } },
    "next_action": { "type": "string" }
  }
}
