# Copia a .env (ignorado por git) o define estas variables en el entorno / GitHub.
# NUNCA pongas aquí el valor real de una clave.
OPENAI_API_KEY=

# Proveedor: mock | manual | openai. Por defecto mock (sin red).
SUPERVISOR_PROVIDER=mock
# Interruptor de llamadas reales. Solo el Product Owner lo pone en true.
SUPERVISOR_LIVE_ENABLED=false
# Modelo del supervisor (elegirlo en la documentación oficial de OpenAI; no hay valor por defecto).
SUPERVISOR_MODEL=
# Esfuerzo de razonamiento si el modelo lo admite (p. ej. medium, high). Vacío = valor del modelo.
SUPERVISOR_REASONING_LEVEL=
SUPERVISOR_MAX_OUTPUT=25000
SUPERVISOR_TIMEOUT=300
SUPERVISOR_MAX_EVIDENCE_ROUNDS=2
SUPERVISOR_MAX_CALLS_PER_GATE=8
SUPERVISOR_MAX_CONTEXT_BYTES=120000
SUPERVISOR_MAX_FILES_PER_REQUEST=8
# Tarifas USD por millón de tokens, copiadas de la página oficial de precios. Vacío = no se calcula costo.
SUPERVISOR_PRICE_INPUT_PER_1M=
SUPERVISOR_PRICE_CACHED_INPUT_PER_1M=
SUPERVISOR_PRICE_OUTPUT_PER_1M=
